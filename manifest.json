{
    "name": "Pretty Buddy",
    "version": "1.0",
    "description": "A Chrome extension to customize websites.",
    "manifest_version": 3,

    "content_scripts": [
        {
            "matches": ["https://*.reddit.com/*", "https://reddit.com/*"],
            "css": ["override-reddit.css"],
            "js": ["remove-element.js", "override-reddit.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://jandan.net/*"],
            "css": ["override-jandan.css"],
            "js": ["remove-element.js", "override-jandan.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://leetcode.com/*"],
            "css": ["override-leetcode.css"],
            "js": ["remove-element.js", "override-leetcode.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://github.com/*"],
            "css": ["override-github.css"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://gemini.google.com/*"],
            "css": ["override-gemini.css"],
            "js": ["override-gemini.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.braveclojure.com/*", "https://braveclojure.com/*"],
            "css": ["override-braveclojure.css"],
            "js": ["override-braveclojure.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://warsus.github.io/*"],
            "css": ["override-lions.css"],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ]
}